            "summary": "关联未使用声明外键或服务端验证关系的完整键",
            "inputs": {
              "sql": "WITH contracts_2025 AS (\n  SELECT 合同编号, 客户编号\n  FROM main.实际合同\n  WHERE 签约日期 >= '2025-01-01' AND 签约日期 < '2026-01-01'\n),\ncontract_count AS (\n  SELECT 客户编号, COUNT(合同编号) AS 合同数量\n  FROM contracts_2025\n  GROUP BY 客户编号\n),\ndetail_amount AS (\n  SELECT c.客户编号, SUM(d.金额) AS 合同明细金额合计\n  FROM contracts_2025 c\n  JOIN main.合同明细 d ON d.合同编号 = c.合同编号\n  GROUP BY c.客户编号\n),\nreceipt_amount AS (\n  SELECT c.客户编号, SUM(r.金额) AS 实际收款合计\n  FROM contracts_2025 c\n  JOIN main.实际收款 r ON r.合同编号 = c.合同编号\n  WHERE r.收款日期 <= '2025-02-28'\n  GROUP BY c.客户编号\n)\nSELECT \n  cust.客户名称,\n  cc.合同数量,\n  COALESCE(da.合同明细金额合计, 0) AS 合同明细金额合计,\n  COALESCE(ra.实际收款合计, 0) AS 实际收款合计\nFROM contract_count cc\nJOIN main.客户 cust ON cust.客户编号 = cc.客户编号\nLEFT JOIN detail_amount da ON da.客户编号 = cc.客户编号\nLEFT JOIN receipt_amount ra ON ra.客户编号 = cc.客户编号",
              "params": [],
              "explanation": "先筛选2025年签约的实际合同，再分别按客户粒度统计合同数量、合同明细金额合计（从合同明细表SUM）和截至2025-02-28的实际收款合计（从实际收款表SUM），三个子查询各自独立聚合避免一对多放大，最后LEFT JOIN合并并用COALESCE保证零收款显示为0。不使用预算、预测或历史备份表。"
            },
            "finished_at": "2026-10-11T03:01:55.029+00:00"
