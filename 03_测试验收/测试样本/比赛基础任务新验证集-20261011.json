      "id": "basic-sql-01",
      "split": "first_exposure",
      "scope": "database",
      "category": "database",
      "question": "查询淮南市2024年的GDP和GDP实际增长率，分别给出亿元和百分比。",
      "source_references": [],
      "reference": {
        "status": "supported",
        "sql": "SELECT metric_id, value FROM public_observations WHERE region_id = 'huainan' AND year = 2024 AND metric_id IN ('gdp','gdp_growth') ORDER BY CASE metric_id WHEN 'gdp' THEN 1 ELSE 2 END",
        "params": [],
        "expected_rows": [
          [
            "gdp",
            1716.0
          ],
          [
            "gdp_growth",
            5.0
          ]
        ],
        "order_matters": true,
        "numeric_tolerance": 1e-07
      }
    },
